---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Web experiments by Costa Fotiadis' } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #fafafa;
        --fg: #1a1a1a;
        --muted: #6b6b6b;
        --accent: #d3562e;
        --card: #ffffff;
        --border: #e4e4e4;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #131313;
          --fg: #e8e8e8;
          --muted: #949494;
          --accent: #ff7847;
          --card: #1c1c1c;
          --border: #2c2c2c;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        background: var(--bg);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, sans-serif;
        line-height: 1.6;
      }
      a {
        color: var(--accent);
      }
      main {
        flex: 1;
        width: 100%;
        max-width: 44rem;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 3rem;
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        {!isHome && <a href="/">← lab</a>}
        {isHome && <span class="brand">lab.</span>}
        <a href="https://costafotiadis.com" class="site-link">costafotiadis.com</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <style>
      nav {
        max-width: 44rem;
        margin: 0 auto;
        padding: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.9rem;
      }
      .brand {
        font-weight: 700;
        color: var(--accent);
      }
      nav a {
        text-decoration: none;
      }
      nav a:hover {
        text-decoration: underline;
      }
      .site-link {
        color: var(--muted);
      }
    </style>
  </body>
</html>
