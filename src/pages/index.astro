---
import Base from '../layouts/Base.astro';

// Every src/pages/<slug>/index.astro that exports an `experiment` object
// shows up here automatically — no registry to maintain.
const modules = import.meta.glob<{
  experiment?: { title: string; description: string; date: string };
}>('./*/index.astro', { eager: true });

const experiments = Object.entries(modules)
  .filter(([, mod]) => mod.experiment)
  .map(([path, mod]) => ({
    href: path.replace('.', '').replace('/index.astro', ''),
    ...mod.experiment!,
  }))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Base title="lab — Costa Fotiadis">
  <h1>Experiments</h1>
  <p class="intro">
    Small web things, built for fun. The serious stuff lives on
    <a href="https://costafotiadis.com">the blog</a>.
  </p>
  <ul>
    {
      experiments.map((e) => (
        <li>
          <a href={e.href}>{e.title}</a>
          <span class="desc">{e.description}</span>
          <time datetime={e.date}>{e.date}</time>
        </li>
      ))
    }
  </ul>
  {experiments.length === 0 && <p>Nothing here yet.</p>}
</Base>

<style>
  h1 {
    font-size: 1.6rem;
    margin: 0 0 0.25rem;
  }
  .intro {
    color: var(--muted);
    margin-top: 0;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  li {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.9rem 1.1rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 1rem;
  }
  li a {
    font-weight: 600;
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
  }
  .desc {
    grid-column: 1;
    color: var(--muted);
    font-size: 0.9rem;
  }
  time {
    grid-row: 1;
    grid-column: 2;
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
</style>
